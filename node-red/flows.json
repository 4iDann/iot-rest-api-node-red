        "z": "flow_api",
        "name": "Simpan Sensor ke SQLite",
        "func": "const data = msg.payload;\n\nif (\n    !data ||\n    data.suhu === undefined ||\n    data.kelembaban === undefined\n) {\n    return null;\n}\n\nmsg.params = {\n    $suhu: Number(data.suhu),\n    $kelembaban: Number(data.kelembaban),\n    $received: data.received || new Date().toISOString()\n};\n\nreturn msg;",
