    {
        "id": "90f27b50544fbfb3",
        "type": "function",
        "z": "flow_api",
        "name": "Validasi & Simpan Threshold",
        "func": "const threshold = Number(msg.payload?.threshold);\n\nif (!Number.isFinite(threshold) || threshold < 0 || threshold > 100) {\n    msg.statusCode = 400;\n    msg.payload = {\n        success: false,\n        message: \"Threshold harus berupa angka antara 0 sampai 100\"\n    };\n    return msg;\n}\n\nflow.set(\"threshold\", threshold);\n\nmsg.statusCode = 200;\nmsg.payload = {\n    success: true,\n    message: \"Batas suhu berhasil diperbarui\",\n    threshold: threshold\n};\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
