    {
        "id": "mqtt_sensor_in",
        "type": "mqtt in",
        "z": "flow_api",
        "name": "Subscribe Sensor",
        "topic": "iot/sensor",
        "qos": "0",
        "datatype": "json",
        "broker": "mqtt_broker_config",
        "nl": false,
        "rap": true,
        "rh": 0,
        "inputs": 0,
        "x": 170,
        "y": 60,
        "wires": [
            [
                "store_sensor"
            ]
        ]
    },
    {
        "id": "store_sensor",
        "type": "function",
        "z": "flow_api",
        "name": "Simpan Data Sensor",
        "func": "// Validasi data sensor\nif (typeof msg.payload !== 'object' || msg.payload === null) {\n    node.warn('Payload sensor bukan objek JSON, diabaikan');\n    return null;\n}\n\n// Simpan data sensor terakhir\nvar data = Object.assign({}, msg.payload, {\n    received: new Date().toISOString()\n});\n\nflow.set('lastSensor', data);\n\n// Kirim data ke node berikutnya\nmsg.payload = data;\n\nnode.warn(\"Waktu Node-RED: \" + new Date().toLocaleString('id-ID', {\n    timeZone: 'Asia/Makassar'\n}));\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 60,
        "wires": [
            [
                "debug_sensor",
                "4d2742f0f9967910",
                "0d65842fc8e53ab0",
                "4a97e317dbf8df8a"
            ]
        ]
    },
