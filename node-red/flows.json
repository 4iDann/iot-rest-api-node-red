        "z": "flow_api",
        "name": "Build Response Suhu",
        "func": "var data = flow.get('lastSensor') || { suhu: null, kelembaban: null, timestamp: null, received: null };\n\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'success',\n    data: data,\n    server_time: new Date().toISOString()\n};\nmsg.headers = { 'Access-Control-Allow-Origin': '*' };\nreturn msg;",
