    {
        "id": "proc_kontrol",
        "type": "function",
        "z": "flow_api",
        "name": "Validasi & Publish",
        "func": "var cors = { 'Access-Control-Allow-Origin': '*' };\nvar body = msg.payload;\n\n// Validasi input -> output 1 saja (balasan HTTP 400)\nif (!body || !body.device || !body.action) {\n    msg.statusCode = 400;\n    msg.payload = { status: 'error', message: 'device dan action wajib diisi' };\n    msg.headers = cors;\n    return [msg, null];\n}\n\n// Output 2: publish ke MQTT\nvar mqttMsg = { topic: 'iot/kontrol', payload: body };\n\n// Output 1: balasan HTTP 200\nmsg.statusCode = 200;\nmsg.payload = { status: 'success', message: 'Perintah terkirim', sent: body };\nmsg.headers = cors;\nreturn [msg, mqttMsg];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 460,
        "wires": [
            [
                "http_resp_kontrol"
            ],
            [
                "mqtt_publish_kontrol"
            ]
        ]
    },
